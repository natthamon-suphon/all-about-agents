# Every text file in this repo is LF, in the repository AND in the working tree.
# The catch-all below is load-bearing: this plugin ships extension-less shell
# scripts (core/skills/subagent-driven-development/scripts/*) that none of the
# globs cover, and bash cannot parse them with CRLF endings.
* text=auto eol=lf

# Ensure shell scripts always have LF line endings
*.sh text eol=lf
core/skills/subagent-driven-development/scripts/* text eol=lf

# Common text files
*.md text eol=lf
*.json text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.ts text eol=lf

# Explicitly mark binary files (last match wins, so these must stay at the end)
*.png binary
*.jpg binary
*.gif binary
