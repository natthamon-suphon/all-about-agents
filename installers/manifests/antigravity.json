{
  "schemaVersion": 1,
  "surface": "antigravity",
  "product": "Antigravity CLI (agy), Antigravity Desktop, and Antigravity IDE",
  "productVersion": "1.4.2",
  "package": "all-about-agents",
  "pluginManifest": "plugin.json",
  "pluginRegistration": {
    "marketplace": null,
    "validateArgs": [
      "plugin",
      "validate",
      "PACKAGE_ROOT"
    ],
    "installArgs": [
      "plugin",
      "install",
      "PACKAGE_ROOT"
    ],
    "discoveryArgs": [
      "plugin",
      "list"
    ]
  },
  "configRoot": {
    "environment": "AAA_ANTIGRAVITY_ROOT",
    "fallback": "~/.gemini",
    "sharedBy": [
      "antigravity-cli",
      "antigravity-desktop"
    ]
  },
  "components": {
    "pluginManifest": "plugin.json",
    "instructions": "config/GEMINI.md",
    "globalInstructions": "config/GEMINI.md",
    "skills": "skills/{skill}/SKILL.md",
    "agents": "agents/{role}.md",
    "manualDesktop": "docs/manual-desktop.md",
    "readme": "README.md",
    "globalRules": "config/rules/all-about-agents.md"
  },
  "profileContract": {
    "source": "profiles/{profile}/profile.json",
    "modelPolicyRefs": [
      "surface-default",
      "approved-gemini-pro"
    ]
  },
  "profiles": {
    "portable": {
      "model": null,
      "effort": null
    },
    "template": {
      "model": null,
      "effort": "xhigh-or-highest-supported",
      "selection": "managed-cli-dynamic",
      "family": "Gemini premium Argon/Pro"
    }
  },
  "semanticCapabilities": {
    "repository-read": [
      "GEMINI.md"
    ],
    "repository-write": [
      "GEMINI.md"
    ],
    "web-primary-sources": [
      "search_web"
    ],
    "isolated-write": [
      "write_file"
    ],
    "command-execution": [
      "run_shell_command"
    ],
    "filesystem-read": [
      "read_file"
    ],
    "filesystem-write": [
      "write_file"
    ],
    "git-read": [
      "run_shell_command"
    ],
    "git-write": [
      "run_shell_command"
    ],
    "test-execution": [
      "run_shell_command"
    ],
    "external-research": [
      "search_web"
    ],
    "evaluation": [
      "run_shell_command"
    ],
    "role-dispatch": [
      "invoke_subagent"
    ],
    "schema-validation": [
      "run_shell_command"
    ],
    "native-rendering": [
      "plugin"
    ],
    "workflow-state": [
      "GEMINI.md"
    ]
  },
  "ownedPaths": [
    "README.md",
    "agents/{role}.md",
    "config/GEMINI.md",
    "config/rules/all-about-agents.md",
    "docs/manual-desktop.md",
    "plugin.json",
    "skills/{skill}/**",
    "skills/{skill}/SKILL.md"
  ],
  "presentation": {
    "registry": "core/presentation/emoji-registry.json",
    "progressContract": "core/presentation/progress-contract.json",
    "renderedIn": "config/rules/all-about-agents.md and native skill/role prompts"
  },
  "rootInstructionContext": "config/GEMINI.md stages one marked block for the native global GEMINI.md; plugin roots carry no GEMINI.md because native strict validation warns it is never loaded. The canonical rules and presentation catalog ship in config/rules/all-about-agents.md; a workspace GEMINI.md remains the more specific layer",
  "hooks": {
    "rendered": false,
    "reason": "Current Google documentation includes SessionStart. This package keeps its routing contract inlined in GEMINI.md and renders no duplicate bootstrap hook. PreCompact support is not established."
  },
  "statusline": {
    "rendered": false,
    "reason": "The removed adapters built a status line command from a plugin path the product never creates, so the rendered status line could not run."
  },
  "nativeValidation": {
    "command": [
      "agy",
      "plugin",
      "validate",
      "PACKAGE_ROOT"
    ],
    "requiredWhenAvailable": true
  },
  "capabilityEvidence": {
    "productContracts": "docs/evaluations/research-antigravity.md",
    "restorationPlan": "docs/plans/2026-09-19-restore-antigravity.md"
  }
}
