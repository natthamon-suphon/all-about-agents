  "ownedPaths": [
    "GEMINI.md",
    "README.md",
    "activity-audit.json",
    "agents/{role}/**",
    "checkpoint.json",
    "emergency-guard.json",
    "hooks.json",
    "plugin.json",
    "rules/**",
    "settings.overlay.json",
    "skills/{skill}/**",
    "statusline/**"
