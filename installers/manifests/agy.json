    "disposablePackageInstall": "agy plugin install PACKAGE_DIRECTORY",
    "manualOnly": true
  },
  "installation": {
    "registration": "agy plugin install PACKAGE_DIRECTORY",
    "automaticInstall": true,
    "automaticInstallMode": "register-apply-after-review",
    "automaticFromRender": false,
    "automaticHookExecution": false,
    "liveProfileWrite": true,
