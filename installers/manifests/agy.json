{
  "schemaVersion": 1,
  "surface": "agy",
  "product": "agy CLI",
  "productVersion": "1.1.22",
  "package": "all-about-agents",
  "pluginManifest": "plugin.json",
  "packageRoot": ".",
  "installedPluginRoot": "~/.gemini/config/plugins/all-about-agents/",
  "components": {
    "pluginManifest": "plugin.json",
    "globalInstructions": {
      "package": "GEMINI.md",
      "destination": "~/.gemini/GEMINI.md",
      "registration": "register --apply",
      "automaticWrite": true
    },
    "hooks": "hooks.json",
    "skills": "skills/{skill}/SKILL.md",
    "agents": "agents/{role}/agent.md",
    "rules": "rules/{rule}.md",
    "settingsOverlay": "settings.overlay.json",
    "statusline": "statusline/statusline.mjs",
    "statuslineConfig": "statusline/statusline.json",
    "statuslineWindowsLauncher": "statusline/statusline.ps1",
    "statuslinePosixLauncher": "statusline/statusline.sh"
  },
  "profileContract": {
    "source": "profiles/{profile}/profile.json",
    "modelPolicyRefs": ["surface-default", "approved-cli-flash"]
  },
  "pluginManifestSchema": {
    "documentedProperties": ["$schema", "name", "description"],
    "additionalProperties": false,
    "schema": "https://antigravity.google/schemas/v1/plugin.json"
  },
  "settingsOverlay": {
    "relativePath": "settings.overlay.json",
    "documentedKeys": [
      "toolPermission",
      "artifactReviewPolicy",
      "allowNonWorkspaceAccess",
      "enableTerminalSandbox",
      "statusLine",
      "permissions.deny"
    ],
    "destinationCandidates": [
      "~/.gemini/antigravity-cli/settings.json"
    ],
    "status": "apply-after-review",
    "automaticWrite": true,
    "reason": "Rendering is read-only. After dry-run review and exact authorization, register --apply merges this sparse overlay into the documented settings file and preserves unknown keys."
  },
  "statuslinePrerequisites": {
    "executable": "node",
    "check": ["node", "--version"],
    "minimumVersion": "22.12.0",
    "onMissing": "reject",
    "requiredBy": ["statusline/statusline.mjs"],
    "platforms": ["win32", "darwin", "linux"]
  },
  "profiles": {
    "portable": {
      "toolPermission": "request-review",
      "artifactReviewPolicy": "asks-for-review",
      "allowNonWorkspaceAccess": false,
      "enableTerminalSandbox": true,
      "emergencyDeny": [
        "command(rm -rf)",
        "command(sudo)",
        "write_file(.git/)",
        "write_file(/home/user/.ssh)"
      ]
    },
    "template": {
      "toolPermission": "always-proceed",
      "artifactReviewPolicy": "always-proceed",
      "allowNonWorkspaceAccess": true,
      "enableTerminalSandbox": false,
      "emergencyDeny": [
        "command(rm -rf)",
        "command(sudo)",
        "write_file(.git/)",
        "write_file(/home/user/.ssh)"
      ],
      "fullAccessArgs": [
        "agy",
        "-p",
        "<prompt>",
        "--model",
        "gemini-3.7-flash-high",
        "--effort",
        "high",
        "--dangerously-skip-permissions"
      ]
    }
  },
  "modelPolicy": {
    "model": "gemini-3.7-flash-high",
    "effort": "high",
    "args": [
      "agy",
      "-p",
      "<prompt>",
      "--model",
      "gemini-3.7-flash-high",
      "--effort",
      "high"
    ],
    "selection": "manual after agy models",
    "unknownSelection": "Fail, run agy models, then retry with an exact operator-selected slug or omit --model; never substitute silently."
  },
  "semanticCapabilities": {
    "repository-read": ["view_file", "list_dir", "find_by_name", "grep_search"],
    "repository-write": ["write_to_file", "replace_file_content", "multi_replace_file_content"],
    "web-primary-sources": ["search_web", "read_url_content"],
    "isolated-write": ["write_to_file", "replace_file_content", "multi_replace_file_content"],
    "command-execution": ["run_command"],
    "filesystem-read": ["view_file", "list_dir", "find_by_name", "grep_search"],
    "filesystem-write": ["write_to_file", "replace_file_content", "multi_replace_file_content"],
    "git-read": ["run_command"],
    "git-write": ["run_command"],
    "test-execution": ["run_command"],
    "external-research": ["search_web", "read_url_content"],
    "evaluation": ["run_command", "view_file"],
    "role-dispatch": ["invoke_subagent", "define_subagent", "manage_subagents"],
    "workflow-state": ["view_file", "write_to_file"],
    "schema-validation": ["run_command"],
    "native-rendering": ["write_to_file"]
  },
  "actions": {
    "aaa:design": {
