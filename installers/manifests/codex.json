{
  "schemaVersion": 1,
  "surface": "codex",
  "product": "Codex CLI and Desktop",
  "productVersion": "0.151.0-alpha.7.2",
  "package": "all-about-agents",
  "pluginManifest": ".codex-plugin/plugin.json",
  "pluginRegistration": {
    "marketplace": "all-about-agents-dev",
    "marketplaceArgs": ["plugin", "marketplace", "add", "PACKAGE_ROOT", "--json"],
    "installArgs": ["plugin", "add", "all-about-agents@all-about-agents-dev", "--json"],
    "discoveryArgs": ["plugin", "list", "--available", "--json"]
  },
  "configRoot": {
    "environment": "CODEX_HOME",
    "fallback": "~/.codex",
    "sharedBy": ["codex-cli", "codex-desktop"]
  },
  "components": {
    "pluginManifest": ".codex-plugin/plugin.json",
    "marketplace": ".agents/plugins/marketplace.json",
    "instructions": "AGENTS.md",
    "globalInstructions": "AGENTS.md",
    "skills": "skills/{skill}/SKILL.md",
    "directSkills": ".agents/skills/{skill}/SKILL.md",
    "agents": ".codex/agents/{role}.toml",
    "primaryConfig": "config.toml",
    "alternateConfig": "terra-max.config.toml",
    "manualDesktop": "docs/manual-desktop.md"
  },
  "profileContract": {
    "source": "profiles/{profile}/profile.json",
    "modelPolicyRefs": ["surface-default", "approved-sol-terra"]
  },
  "profiles": {
    "portable": {
      "config": {
        "sandbox_mode": "workspace-write",
        "approval_policy": "on-request"
      }
    },
    "template": {
      "config": {
        "model": "gpt-5.6-sol",
        "model_reasoning_effort": "max",
        "sandbox_mode": "danger-full-access",
        "approval_policy": "never"
      },
      "alternate": {
        "name": "terra-max",
        "model": "gpt-5.6-terra",
        "model_reasoning_effort": "max"
      }
    }
  },
  "semanticCapabilities": {
    "repository-read": ["AGENTS.md"],
    "repository-write": ["AGENTS.md"],
    "web-primary-sources": ["web_search"],
    "isolated-write": ["workspace-write"],
    "command-execution": ["shell"],
    "filesystem-read": ["AGENTS.md"],
    "filesystem-write": ["workspace-write"],
    "git-read": ["git"],
    "git-write": ["git"],
    "test-execution": ["shell"],
    "external-research": ["web_search"],
    "evaluation": ["shell"],
    "role-dispatch": ["agents"],
    "workflow-state": ["AGENTS.md"],
    "schema-validation": ["shell"],
    "native-rendering": ["plugin"]
  },
  "actions": {
    "aaa:design": "AGENTS.md",
    "aaa:build": "AGENTS.md",
    "aaa:fix": "AGENTS.md",
    "aaa:review": "AGENTS.md",
    "aaa:audit": "AGENTS.md",
    "aaa:improve-skill": "AGENTS.md",
    "aaa:resume": "AGENTS.md",
    "aaa:verify": "AGENTS.md"
  },
  "ownedPaths": [
    ".agents/plugins/marketplace.json",
    ".agents/skills/{skill}/**",
    ".agents/skills/{skill}/SKILL.md",
    ".codex-plugin/plugin.json",
    ".codex/agents/{role}.toml",
    "AGENTS.md",
    "agents/{role}.toml",
    "config.toml",
    "docs/manual-desktop.md",
    "hooks/**",
    "hooks/hooks.json",
    "hooks/{name}.json",
    "hooks/{name}.mjs",
    "skills/{skill}/**",
    "skills/{skill}/SKILL.md",
    "terra-max.config.toml"
  ],
  "presentation": {
    "registry": "core/presentation/emoji-registry.json",
    "progressContract": "core/presentation/progress-contract.json",
    "renderedIn": "AGENTS.md and native skill/role prompts"
  },
  "rootInstructionContext": "AGENTS.md is emitted with the canonical global body first, followed by Codex rules, presentation labels, and action-to-workflow mappings; project AGENTS.md remains the more specific layer",
  "nativeValidation": {
    "command": ["codex", "doctor", "--json", "--no-color"],
    "requiredWhenAvailable": true
  },
  "capabilityEvidence": {
    "productContracts": "docs/evaluations/research-codex.md",
    "modelPolicy": "docs/evaluations/research-model-policy-codex.md"
  }
}
