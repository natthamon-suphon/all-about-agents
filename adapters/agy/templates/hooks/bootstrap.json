{
  "schemaVersion": 1,
  "surface": "agy",
  "module": "bootstrap",
  "event": "PreInvocation",
  "contentRef": "core/skills/using-all-about-agents/SKILL.md",
  "failureMode": "fail-open",
  "runtime": {
    "executable": "node",
    "minimumVersion": "22.12.0",
    "preflight": "required",
    "missingRuntime": "unavailable"
  },
  "input": {
    "format": "json-object",
    "fields": {
      "invocationNum": "integer",
      "initialNumSteps": "integer"
    },
    "malformedOutput": {},
    "malformedDiagnostic": "Bootstrap skipped: malformed hook input; the session continues without injected context."
  },
  "firstSessionWhen": {
    "invocationNum": 0,
    "initialNumSteps": 0
  },
  "firstSessionOutput": {
    "injectSteps": [
      {
        "ephemeralMessage": "{{canonicalContent}}"
      }
    ]
  },
  "otherSessionOutput": {
    "injectSteps": []
  }
}
