{
  "schemaVersion": 1,
  "surface": "codex",
  "module": "bootstrap",
  "description": "Workspace bootstrap hook.",
  "event": "SessionStart",
  "nativeMatcher": "^startup$",
  "command": "node \"$PLUGIN_ROOT/hooks/bootstrap.mjs\" --surface codex --skill-path \"$PLUGIN_ROOT/.agents/skills/using-all-about-agents/SKILL.md\" --config-path \"$PLUGIN_ROOT/hooks/bootstrap.json\"",
  "commandWindows": "node \"%PLUGIN_ROOT%/hooks/bootstrap.mjs\" --surface codex --skill-path \"%PLUGIN_ROOT%/.agents/skills/using-all-about-agents/SKILL.md\" --config-path \"%PLUGIN_ROOT%/hooks/bootstrap.json\"",
  "contentRef": "core/skills/using-all-about-agents/SKILL.md",
  "failureMode": "fail-open",
  "runtime": {
    "executable": "node",
    "minimumVersion": "22.12.0",
    "preflight": "required",
    "missingRuntime": "unavailable"
  },
  "input": {
    "format": "json-object",
    "malformedOutput": {},
    "malformedDiagnostic": "Bootstrap skipped: malformed hook input; the session continues without injected context."
  },
  "firstSessionOutput": {
    "hookSpecificOutput": {
      "hookEventName": "SessionStart",
      "additionalContext": "{{canonicalContent}}"
    }
  },
  "otherSessionOutput": {}
}
