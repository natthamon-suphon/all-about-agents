{
  "schemaVersion": 1,
  "surface": "claude",
  "module": "emergency-guard",
  "event": "PreToolUse",
  "automatic": true,
  "probeRequired": false,
  "nativeMatcher": ".*",
  "commandContract": "package-root",
  "trustRequired": false,
  "contentRef": "core/hooks/emergency-guard.json",
  "failureMode": "fail-open",
  "input": {
    "format": "json-object",
    "documentedFields": [
      "hook_event_name",
      "tool_name",
      "tool_input",
      "tool_use_id"
    ]
  },
  "denyOutput": {
    "hookSpecificOutput": {
      "hookEventName": "PreToolUse",
      "permissionDecision": "deny",
      "permissionDecisionReason": "{{boundedReason}}"
    }
  }
}

