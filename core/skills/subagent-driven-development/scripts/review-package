#!/usr/bin/env bash
# Generate a review package: commit list, stat summary, and net diff. Cross-platform wrapper delegating to Node.js when available.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

if command -v node >/dev/null 2>&1; then
  exec node "${SCRIPT_DIR}/review-package.js" "$@"
fi

if [ "${1:-}" = "--snapshot" ] || [ "${3:-}" = "WORKTREE" ]; then
  echo "review-package: --snapshot and WORKTREE need node" >&2
  exit 2
fi

if [ $# -lt 3 ] || [ $# -gt 4 ]; then
  echo "usage: review-package PLAN_FILE BASE HEAD [OUTFILE]" >&2
  exit 2
fi

plan=$1
base=$2
head=$3
[ -f "$plan" ] || { echo "no such plan file: $plan" >&2; exit 2; }

git rev-parse --verify --quiet --end-of-options "${base}^{commit}" >/dev/null 2>&1 || { echo "bad BASE commit: $base" >&2; exit 2; }
git rev-parse --verify --quiet --end-of-options "${head}^{commit}" >/dev/null 2>&1 || { echo "bad HEAD commit: $head" >&2; exit 2; }
if git diff --quiet "$base" "$head"; then
  echo "empty review package: nothing changed between ${base} and ${head}; do not dispatch a review" >&2
  exit 3
fi

if [ $# -eq 4 ]; then
  out=$4
else
  dir=$("${SCRIPT_DIR}/sdd-workspace" "$plan")
  out="$dir/review-$(git rev-parse --short "$base")..$(git rev-parse --short "$head").diff"
fi

{
  echo "# Review package: ${base}..${head}"
  echo
  echo "## Commits"
  git log --oneline "${base}..${head}"
  echo
  echo "## Files changed"
  git diff --stat "${base}..${head}"
  echo
  echo "## Diff"
  git diff -U10 "${base}..${head}"
} > "$out"

commits=$(git rev-list --count "${base}..${head}")
echo "wrote ${out}: ${commits} commit(s), $(wc -c < "$out" | tr -d ' ') bytes"
