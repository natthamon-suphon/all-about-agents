#!/usr/bin/env bash
# Resolve and ensure the working-tree directory SDD uses for one plan's
# short-lived artifacts. Cross-platform wrapper delegating to Node.js when available.
set -euo pipefail
CDPATH=''

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

if command -v node >/dev/null 2>&1; then
  exec node "${SCRIPT_DIR}/sdd-workspace.cjs" "$@"
fi

if [ $# -ne 1 ]; then
  echo "usage: sdd-workspace PLAN_FILE" >&2
  exit 2
fi

plan=$1
[ -f "$plan" ] || { echo "no such plan file: $plan" >&2; exit 2; }

plan_dir=$(cd "$(dirname "$plan")" && pwd)
dir="$plan_dir/sdd"
if [ -L "$dir" ]; then
  echo "refusing a symlinked sdd/ folder: $dir" >&2
  exit 2
fi
if [ -e "$dir" ] && [ ! -d "$dir" ]; then
  echo "sdd/ is not a folder: $dir" >&2
  exit 2
fi
mkdir -p "$dir"
[ -e "$dir/.gitignore" ] || [ -L "$dir/.gitignore" ] || (set -C; printf '*\n' > "$dir/.gitignore")
cd "$dir" && pwd
