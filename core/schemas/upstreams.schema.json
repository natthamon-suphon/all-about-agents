{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Reviewed upstream provenance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "checkedAt",
    "upstreams",
    "dispositions",
    "policyNotes"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "checkedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "upstreams": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "url",
          "version",
          "tag",
          "resolvedCommit"
        ],
        "properties": {
          "id": {
            "enum": [
              "superpowers",
              "matt-pocock"
            ]
          },
          "url": {
            "type": "string"
          },
          "version": {
            "type": "string",
            "pattern": "\\S"
          },
          "tag": {
            "type": "string",
            "pattern": "\\S"
          },
          "resolvedCommit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "publishedRelease": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tag",
              "resolvedCommit"
            ],
            "properties": {
              "tag": {
                "type": "string",
                "pattern": "\\S"
              },
              "resolvedCommit": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              }
            }
          }
        },
        "oneOf": [
          {
            "properties": {
              "id": {
                "const": "superpowers"
              },
              "url": {
                "const": "https://github.com/obra/superpowers"
              }
            }
          },
          {
            "properties": {
              "id": {
                "const": "matt-pocock"
              },
              "url": {
                "const": "https://github.com/mattpocock/skills"
              }
            }
          }
        ]
      }
    },
    "policyNotes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "\\S"
      }
    },
    "dispositions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "skill",
          "disposition",
          "sources",
          "notes"
        ],
        "properties": {
          "skill": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "disposition": {
            "enum": [
              "adapted",
              "retained",
              "local-only"
            ]
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "upstream",
                "paths"
              ],
              "properties": {
                "upstream": {
                  "type": "string"
                },
                "paths": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "\\S"
                  }
                }
              }
            }
          },
          "notes": {
            "type": "string",
            "pattern": "\\S"
          }
        }
      }
    }
  }
}
