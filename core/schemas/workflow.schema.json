{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Portable workflow state machine",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "initialState", "states", "transitions", "gates", "recovery", "allowedRoles", "successCriteria"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "initialState": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "states": {
      "type": "array", "minItems": 1,
      "items": {
        "anyOf": [
          { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          { "type": "object", "additionalProperties": false, "required": ["id"], "properties": {
            "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
            "description": { "type": "string", "minLength": 1 },
            "terminal": { "type": "boolean" },
            "stopCondition": { "type": "string", "minLength": 1 },
            "durableOutput": { "type": "string", "minLength": 1 }
          } }
        ]
      }
    },
    "transitions": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": false, "required": ["from", "to"], "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "from": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "to": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "on": { "type": "string", "minLength": 1 },
        "requiresApproval": { "type": "boolean" },
        "allowedRoles": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" } },
        "command": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
      } }
    },
    "gates": {
      "type": "array", "items": { "anyOf": [
        { "type": "string", "minLength": 1 },
        { "type": "object", "additionalProperties": false, "required": ["id"], "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "state": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "requirement": { "type": "string", "minLength": 1 },
          "onFailure": { "type": "string", "minLength": 1 }
        } }
      ] }
    },
    "recovery": { "type": ["object", "array", "string"] },
    "allowedRoles": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" } },
    "successCriteria": { "anyOf": [
      { "type": "string", "minLength": 1 },
      { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
    ] },
    "capabilities": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "requiredSkills": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" } }
  }
}
