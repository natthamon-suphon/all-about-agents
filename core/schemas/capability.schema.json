{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Native adapter capability record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "surface",
    "checkedAt",
    "productVersion",
    "capabilities"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "surface": {
      "type": "string",
      "enum": [
        "antigravity",
        "claude",
        "codex"
      ]
    },
    "checkedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "productVersion": {
      "type": "string",
      "minLength": 1
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/capability"
      }
    }
  },
  "$defs": {
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "feature",
        "support",
        "stability",
        "source",
        "checkedAt",
        "productVersion",
        "value",
        "notes"
      ],
      "properties": {
        "feature": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]*$"
        },
        "support": {
          "type": "string",
          "enum": [
            "supported",
            "unsupported",
            "manual",
            "unknown"
          ]
        },
        "stability": {
          "type": "string",
          "enum": [
            "stable",
            "experimental",
            "manual",
            "unsupported",
            "unknown"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "checkedAt": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "productVersion": {
          "type": "string",
          "minLength": 1
        },
        "value": {},
        "notes": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
