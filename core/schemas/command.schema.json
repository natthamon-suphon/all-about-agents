{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Portable command action",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "actionId", "workflowId", "arguments", "result"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "actionId": { "type": "string", "pattern": "^aaa:[a-z0-9][a-z0-9-]*$" },
    "workflowId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "arguments": { "type": "object" },
    "result": { "type": "object" },
    "capabilities": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "requiredCapabilities": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "skills": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" } },
    "requiredSkills": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" } },
    "presentation": { "type": "object", "additionalProperties": false, "properties": {
      "label": { "type": "string", "minLength": 1 },
      "help": { "type": "string", "minLength": 1 }
    } }
  }
}
