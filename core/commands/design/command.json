{
  "$schema": "../../schemas/command.schema.json",
  "id": "design",
  "actionId": "aaa:design",
  "workflowId": "design-change",
  "arguments": {
    "type": "object",
    "properties": {
      "request": { "type": "string", "minLength": 1 }
    },
    "required": ["request"],
    "additionalProperties": false
  },
  "result": {
    "type": "object",
    "properties": {
      "status": { "type": "string" },
      "workflowId": { "type": "string" },
      "artifacts": { "type": "array" },
      "diagnostics": { "type": "array" }
    },
    "required": ["status", "workflowId"],
    "additionalProperties": false
  },
  "presentation": {
    "label": "Design",
    "help": "Start the design-change workflow for a requested change."
  }
}
