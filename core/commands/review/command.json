{
  "$schema": "../../schemas/command.schema.json",
  "id": "review",
  "actionId": "aaa:review",
  "workflowId": "review-and-audit",
  "arguments": {
    "type": "object",
    "properties": {
      "request": { "type": "string", "minLength": 1 }
    },
    "required": ["request"],
    "additionalProperties": false
  },
  "result": {
    "type": "object",
    "properties": {
      "status": { "type": "string" },
      "workflowId": { "type": "string" },
      "artifacts": { "type": "array" },
      "diagnostics": { "type": "array" }
    },
    "required": ["status", "workflowId"],
    "additionalProperties": false
  },
  "presentation": {
    "label": "Review",
    "help": "Review correctness, security, and architecture with evidence."
  }
}
