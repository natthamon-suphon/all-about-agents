{
  "$schema": "../../schemas/command.schema.json",
  "id": "fix",
  "actionId": "aaa:fix",
  "workflowId": "fix-bug",
  "arguments": {
    "type": "object",
    "properties": {
      "request": { "type": "string", "minLength": 1 }
    },
    "required": ["request"],
    "additionalProperties": false
  },
  "result": {
    "type": "object",
    "properties": {
      "status": { "type": "string" },
      "workflowId": { "type": "string" },
      "artifacts": { "type": "array" },
      "diagnostics": { "type": "array" }
    },
    "required": ["status", "workflowId"],
    "additionalProperties": false
  },
  "presentation": {
    "label": "Fix",
    "help": "Run the reproduce-to-verification fix-bug workflow."
  }
}
