{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Redacted evaluation result envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sampleId",
    "caseId",
    "variant",
    "output",
    "scores",
    "metadata"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "sampleId": {
      "type": "string"
    },
    "caseId": {
      "type": "string"
    },
    "variant": {
      "type": "string",
      "enum": [
        "control",
        "candidate"
      ]
    },
    "output": {
      "type": "string"
    },
    "scores": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}
