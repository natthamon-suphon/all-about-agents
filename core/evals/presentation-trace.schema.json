{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Structured presentation trace",
  "type": "object",
  "additionalProperties": false,
  "required": ["invocationId", "events"],
  "properties": {
    "invocationId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*(?::[a-z0-9][a-z0-9-]*)?$", "minLength": 1, "maxLength": 128 },
    "events": {
      "type": "array",
      "minItems": 2,
      "maxItems": 64,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "kind", "id", "label", "reason"],
            "properties": {
              "type": { "const": "announcement" },
              "kind": { "enum": ["skill", "role", "subagent", "command", "workflow", "hook", "profile"] },
              "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*(?::[a-z0-9][a-z0-9-]*)?$", "minLength": 1, "maxLength": 128 },
              "label": { "type": "string", "minLength": 1, "maxLength": 160 },
              "reason": { "type": "string", "minLength": 1, "maxLength": 160 },
              "workflowId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*(?::[a-z0-9][a-z0-9-]*)?$", "minLength": 1, "maxLength": 128 }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "revision", "owner", "items"],
            "properties": {
              "type": { "const": "checklist" },
              "revision": { "type": "integer", "minimum": 1 },
              "owner": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*(?::[a-z0-9][a-z0-9-]*)?$", "minLength": 1, "maxLength": 128 },
              "items": {
                "type": "array",
                "minItems": 2,
                "maxItems": 7,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["id", "text", "status"],
                  "properties": {
                    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*(?::[a-z0-9][a-z0-9-]*)?$", "minLength": 1, "maxLength": 128 },
                    "text": { "type": "string", "minLength": 1, "maxLength": 240 },
                    "status": { "enum": ["pending", "in-progress", "completed", "blocked", "failed", "not-run", "skipped"] },
                    "owner": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*(?::[a-z0-9][a-z0-9-]*)?$", "minLength": 1, "maxLength": 128 },
                    "reason": { "type": "string", "minLength": 1, "maxLength": 160 }
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["type"],
            "properties": {
              "type": { "const": "completion" }
            }
          }
        ]
      }
    }
  }
}
