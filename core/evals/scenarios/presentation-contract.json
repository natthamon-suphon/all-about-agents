                "type": "checklist",
                "revision": 1,
                "owner": "sequential",
                "items": [
                  {
                    "id": "normal",
                    "text": "Complete the normal check",
                    "status": "completed"
                  },
                  {
                    "id": "blocked-item",
                    "text": "Run the unavailable check",
                    "status": "blocked",
                    "reason": "Required access was not available."
                  },
                  {
                    "id": "failed-item",
                    "text": "Run the failing check",
                    "status": "failed",
                    "reason": "The check failed with a reproducible error."
                  },
                  {
                    "id": "skipped-item",
                    "text": "Run the optional check",
                    "status": "skipped",
                    "reason": "The optional check is outside this scope."
                  },
                  {
                    "id": "not-run-item",
                    "text": "Run the native check",
                    "status": "not-run",
                    "reason": "The native product was not available."
                  }
                ]
              },
              {
                "type": "completion"
              }
            ]
          }
        }
      ]
