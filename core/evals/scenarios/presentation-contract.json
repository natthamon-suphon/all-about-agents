              {
                "type": "checklist",
                "revision": 1,
                "owner": "sequential",
                "items": [
                  {
                    "id": "completed",
                    "text": "Complete the verified step",
                    "status": "completed"
                  },
                  {
                    "id": "blocked",
                    "text": "Check the unavailable step",
                    "status": "blocked",
                    "reason": "The dependency was unavailable."
                  },
                  {
                    "id": "failed",
                    "text": "Check the failed step",
                    "status": "failed",
                    "reason": "The command returned a failure."
                  },
                  {
                    "id": "not-run",
                    "text": "Check the native step",
                    "status": "not-run",
                    "reason": "No native session was available."
                  },
                  {
                    "id": "skipped",
                    "text": "Check the optional step",
                    "status": "skipped",
                    "reason": "The optional step was excluded."
                  }
                ]
              },
              {
                "type": "completion"
              }
            ]
          }
        }
